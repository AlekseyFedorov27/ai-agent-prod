# ==========================================
# AI Agent Prod: конфигурация окружения
# Скопируйте в .env и заполните. Файл .env не коммитьте.
# ==========================================

# --- Доступ к API ---
# Ключ для заголовка X-API-Key (минимум 16 символов).
# Сгенерировать: openssl rand -hex 24
API_KEY=замените-на-длинную-случайную-строку
# Разрешённые источники для CORS, через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Общий лимит запросов к чату в минуту
RATE_LIMIT_PER_MINUTE=30

# --- LLM (любой OpenAI-совместимый провайдер) ---
OPENAI_API_KEY=thk_live_YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://tokenharbor.ai/v1
LLM_MODEL=deepseek-v4.1-flash:free

# --- PostgreSQL ---
# Пароль в POSTGRES_URI должен совпадать с POSTGRES_PASSWORD.
# Если том с данными уже создан раньше, действует тот пароль, с которым он инициализирован.
POSTGRES_PASSWORD=postgres
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@postgres:5432/langgraph_db

# --- Redis ---
REDIS_URI=redis://redis:6379

# --- Langfuse (необязательно: без ключей трассировка выключена) ---
# Секреты сервера Langfuse (обязательны для docker compose). Сгенерировать: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=замените-на-случайную-строку
LANGFUSE_SALT=замените-на-случайную-строку
# Для бэкенда: адрес сервера и ключи проекта (создаются в интерфейсе http://localhost:3000)
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=3

# --- Загрузка файлов ---
MAX_UPLOAD_MB=10
